# Minder Net Zero environment example
#
# Copy this file to .env.local only for local development. In Vercel, enter
# runtime variables individually and store every secret in the secret manager.
# Never commit real secrets.

# -----------------------------------------------------------------------------
# MODE — choose one mode; never combine production and legacy credentials.
# -----------------------------------------------------------------------------

# Safe example default: legacy/local mode. For the production platform, change
# BOTH values to "clerk". A mixed setting is an invalid cutover.
AUTH_MODE=legacy
NEXT_PUBLIC_AUTH_MODE=legacy

# -----------------------------------------------------------------------------
# PRODUCTION PLATFORM RUNTIME — deploy only when both mode values are "clerk".
# -----------------------------------------------------------------------------

# Clerk production instance. Organizations must be invitation-only and MFA
# must be required. The webhook secret belongs to this exact deployment URL.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=

# Use two different TLS Postgres credentials:
# - DATABASE_URL: pooled URL whose username is minder_runtime
# - IDENTITY_DATABASE_URL: dedicated URL whose username is minder_identity
# Neither role is the database owner or migration administrator.
DATABASE_URL=
IDENTITY_DATABASE_URL=

# Optional bounded pool settings. Defaults are 3, 10, and 20 respectively.
# DB_POOL_MAX=3
# DB_CONNECT_TIMEOUT_SECONDS=10
# DB_IDLE_TIMEOUT_SECONDS=20

# OPENAI_API_KEY and OPENAI_MODEL are intentionally absent from the production
# runtime example. Central historical calibration and central AI assessment are
# not production-backed yet. Keep production candidate text away from AI.

# -----------------------------------------------------------------------------
# OPERATOR-ONLY BOOTSTRAP — DO NOT DEPLOY THESE VARIABLES TO VERCEL.
# -----------------------------------------------------------------------------

# Uncomment only in an isolated operator shell or private local env file. The
# admin URL must be an unpooled TLS URL for a third, dedicated migration role.
# DATABASE_ADMIN_URL=
# CLERK_ORGANIZATION_ID=org_...
# CLERK_OWNER_USER_ID=user_...
# MINDER_DEPLOYMENT_ENV=staging
# MINDER_COMPETITION_NAME=Minder Net Zero Challenge
# MINDER_COMPETITION_SLUG=minder-net-zero-2026
# MINDER_COMPETITION_TIMEZONE=Asia/Ho_Chi_Minh
# MINDER_DATA_REGION=aws-ap-southeast-1
# MINDER_DATA_REGION_APPROVED=YES
# MINDER_BOOTSTRAP_CONFIRM=org_...:minder-net-zero-2026

# -----------------------------------------------------------------------------
# LEGACY POSTGRES PILOT — shared password, central DB, de-identified test data.
# -----------------------------------------------------------------------------

# Required only for a deployed legacy pilot. localhost bypasses the login gate
# for development. Use long, independently generated random values.
ORGANISER_ACCESS_CODE=
SESSION_SECRET=

# Required by the Postgres pilot branch. Use a TLS transaction-pooler URL whose
# login role is a member of netzero_app; never use the postgres/migration owner
# as the deployed runtime. The operator applies migrations separately through a
# direct port-5432 owner connection in an isolated shell.
PILOT_DATABASE_URL=

# Optional Upstash REST store used only for persistent legacy password changes.
AUTH_KV_REST_API_URL=
AUTH_KV_REST_API_TOKEN=

# Optional legacy Phase 4/5 AI prototype. This is not the central production AI
# workflow. Enable only for an approved, supervised, de-identified pilot.
# OPENAI_API_KEY=
# OPENAI_MODEL=
